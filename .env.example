# ==============================================================================
# LanAlmanac Environment Configuration Reference
# Copy this file to .env and customize values for your deployment.
# ==============================================================================

# --- Admin Authentication ---
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin

# --- Credential Vault ---
# Master password used to seal/unseal the AES-256-GCM credential vault.
# If set, the vault automatically unseals at application startup.
# If omitted, you must manually unseal the vault from the Web GUI.
GNM_VAULT_PASSWORD=change_this_to_a_secure_master_password

# --- Agentless Package Management Worker ---
# Shared HMAC-SHA256 secret between LanAlmanac core and the stateless pkg-worker.
# Must be at least 32 characters long.
GNM_PKG_WORKER_AUTH_SECRET=generate_a_random_32_char_secret_for_hmac_sha256!

# URL of the pkg-worker service. When using host network mode in docker-compose.prod.yml:
GNM_PKG_WORKER_BASE_URL=http://127.0.0.1:8081

# --- Docker Images (Optional) ---
# Override when testing development builds from branches or pull requests.
# Defaults:
# GNM_APP_IMAGE=ghcr.io/skoczo/lanalmanac:latest
# GNM_PKG_WORKER_IMAGE=ghcr.io/skoczo/lanalmanac-pkg-worker:latest
# For dev builds on branch 'agentless-package-management':
# GNM_APP_IMAGE=ghcr.io/skoczo/lanalmanac:dev-agentless-package-management
# GNM_PKG_WORKER_IMAGE=ghcr.io/skoczo/lanalmanac-pkg-worker:dev-agentless-package-management

# --- Database & Redis (Optional Overrides) ---
POSTGRES_USER=lanalmanac
POSTGRES_PASSWORD=lanalmanacpassword
POSTGRES_DB=lanalmanac

